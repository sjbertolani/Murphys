# Project
PROJECT_ID=your-gcp-project
REGION=us-west1
REPO=murphy
IMAGE=us-west1-docker.pkg.dev/your-gcp-project/murphy/murphy:latest

# Cloud SQL Postgres
CLOUD_SQL_CONNECTION_NAME=your-gcp-project:us-west1:murphy-postgres
DB_NAME=murphy
DB_USER=murphy_app
DB_PASS=replace-me
PRIVATE_IP=false

# BigQuery
BQ_PROJECT_ID=your-gcp-project
BQ_DATASET=murphy
BQ_LOCATION=US

# Provider and LLM keys
OPENAI_API_KEY=replace-me
MARKET_DATA_API_KEY=replace-me
ALPHA_VANTAGE_FREE_API_KEY=replace-me
